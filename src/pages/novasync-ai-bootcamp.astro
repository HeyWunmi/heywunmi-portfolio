import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import VideoPreview from '../components/VideoPreview.astro';
---
<BaseLayout title="NovaSync AI Bootcamp: Automated Enrollment" description="Course enrollment and student onboarding using Base44, Selar notifications, Google Apps Script and Google Sheets."><section class="section case-hero"><p class="eyebrow">Earlier project / archive</p><h1>NovaSync AI Website Builder Bootcamp</h1><p>The earlier Base44 and Selar bootcamp connects course enrollment with payment record-keeping and welcome emails. It is a separate system from the newer AI Mastery Class.</p><a class="text-link" href="/#portfolio">Return to selected work</a></section>
<section class="section case-video"><h2>The course experience.</h2><VideoPreview file="bootcamp-demo" poster="bootcamp" title="NovaSync AI Website Builder Bootcamp: course overview" note="A short tour of the course website and curriculum. This silent excerpt omits checkout details and private records; the automation logic is shown separately below."/></section>
<section class="section evidence-section"><p class="eyebrow">Behind the Automation</p><h2>From sale notification<br/> to student onboarding.</h2><p>The Payment Workflow script searches unread Selar sale emails, extracts customer information, records payment in the Cohort 2 sheet, sends a welcome email and marks the notification as processed.</p><EvidenceImage id="bootcamp-payment" alt="Payment Workflow Apps Script showing processSelarPayments and the five onboarding steps" caption="Original implementation excerpt showing processSelarPayments. The code documents the workflow logic; it does not by itself prove a successful end-to-end transaction."/><p><a class="text-link" href="/ai-mastery-class/">Explore the newer AI Mastery Class ↗</a></p></section></BaseLayout>
