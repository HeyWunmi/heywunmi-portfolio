---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import VideoPreview from '../components/VideoPreview.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
export function getStaticPaths(){return projects.map(project=>({params:{project:project.slug},props:{project}}));}
interface Props {project: typeof projects[number]}
const {project:p}=Astro.props;
---
<BaseLayout title={p.seoTitle} description={p.description}>
 <section class="section case-hero"><a class="back-link" href="/#portfolio">← Selected work</a><p class="eyebrow">{p.category}</p><h1>{p.title}</h1><p class="case-subtitle">{p.subtitle}</p><p class="case-intro">{p.description}</p><p class="project-status">Portfolio implementation · Project walkthrough and evidence</p><ul class="tool-list" aria-label="Tools and capabilities">{p.tools.map(tool=><li>{tool}</li>)}</ul>{p.live && <a class="text-link" href={p.live} target="_blank" rel="noopener noreferrer">Visit graduation portal <span class="sr-only">(opens in a new tab)</span>↗</a>}<EvidenceImage id={p.image} alt={`${p.title}: original interface`} caption={p.slug==='travel-command-center'?'Original interface, with travel dates and the route obscured.': 'Original project interface. Select to inspect at full size.'} eager/>
 </section>
 <section class="section case-context"><div><p class="eyebrow">The operational challenge</p><h2>What needed<br/> to work better.</h2></div><div><p>{p.problem}</p><h3>My contribution</h3><p>{p.contribution}</p></div></section>
 <section class="case-workflow-band"><div class="section"><p class="eyebrow">The workflow</p><h2>{p.slug==='travel-command-center'?'One place for the moving parts.':'From first step to follow-through.'}</h2><ol class="process-flow">{p.workflow.map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol><div class="logic-grid"><div class="logic-callout"><strong>{p.callout}</strong><span>{p.calloutLabel}</span></div><div><h3>{p.logicTitle}</h3><p>{p.logic}</p></div></div></div></section>
 {p.video && <section class="section case-video"><p class="eyebrow">In motion / recorded demonstration</p><h2>See the experience.</h2><VideoPreview file={p.video} poster={p.image} title={`${p.title}: recorded demonstration`} note={p.videoNote}/><details class="text-transcript"><summary>Read the workflow description</summary><p>{p.description}</p><p>{p.workflow.join(' → ')}.</p><p>{p.logic}</p></details></section>}
 {p.evidence.length>0 && <section class="section evidence-section"><p class="eyebrow">Behind the interface</p><h2>The work underneath.</h2><div class:list={['case-evidence',{'email-evidence':p.slug==='ai-mastery-class'}]}>{p.evidence.map(item=><article><h3>{item.title}</h3><EvidenceImage id={item.id} alt={item.title} caption={item.caption}/></article>)}</div></section>}
 <section class="section outcome-section"><div><p class="eyebrow">Functional outcome</p><h2>{p.slug==='travel-command-center'?'Clarity across a complex journey.':'A connected operational experience.'}</h2></div><div><p>{p.outcome}</p>{p.missing && <p class="evidence-note-text">{p.missing}</p>}</div></section>
 <section class="contact-band"><div class="section case-cta"><div><p class="eyebrow">Have a similar operational challenge?</p><h2>Let's make it<br/> work better.</h2></div><a class="button light" href={site.booking} target="_blank" rel="noopener noreferrer">Discuss your workflow <span class="sr-only">(opens in a new tab)</span>↗</a></div></section>
</BaseLayout>
