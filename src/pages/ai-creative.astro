---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import VideoPreview from '../components/VideoPreview.astro';
import {site} from '../data/site';
const films=[{file:'coca-cola',poster:'coke-poster',brand:'Coca-Cola',title:'The Sound of Together',label:'Spec / concept film',description:'A cinematic brand concept exploring connection and shared experiences, using AI-generated visuals and storytelling to capture the feeling of togetherness.'},{file:'qatar',poster:'qatar-poster',brand:'Qatar Airways',title:'The Experience',label:'Spec / concept film',description:'A luxury travel commercial concept built around atmosphere, elegance and the feeling of travelling somewhere extraordinary.'},{file:'burger',poster:'burger-poster',brand:'Burger Nation',title:'Worth the Wait',label:'Spec / concept film',description:'A food advertising concept designed to make the product irresistible through appetising visuals, cinematic presentation and anticipation.'},{file:'adunme',poster:'adunme-poster',brand:'ADÚNME',title:'There Has to Be an Easier Way',label:'Creative concept / commission status unconfirmed',description:'A narrative-led product commercial that uses humour and everyday frustration to introduce a more convenient solution.'}];
const personas=[['character-burgundy','One persona. Multiple frames.','Burgundy fashion character lookbook'],['character-blonde','Consistency across a campaign.','Blonde character shown in multiple campaign variations'],['character-gray','City style / gray blazer','Virtual creator in a gray blazer dress'],['character-sage','Everyday style / sage','Virtual creator mirror portrait in a sage outfit'],['night-olive','After dark / olive','Night-out character study in an olive outfit'],['night-burgundy','After dark / burgundy','Night-out character study in a burgundy dress']];
const photos=[['newspaper','Newspaper environment','Overhead editorial portrait surrounded by newspapers'],['green-studio','Green studio','Studio portrait in a draped green outfit'],['overhead','A different perspective','Male portrait photographed from overhead'],['birthday-one','Level three','Childrens birthday editorial on white podiums'],['birthday-two','A birthday story','Childrens birthday editorial with white balloons'],['birthday-twelve','Twelve','Birthday portrait with silver number balloons'],['scorpio','Burgundy statement','Burgundy zodiac editorial portrait'],['hooded-beauty','Close-up / beauty','Beauty portrait framed by a gray hood'],['beauty-lipstick','Beauty concept','Lipstick beauty concept with sunglasses']];
---
<BaseLayout title="AI Creative: Generative Visuals" description="Original AI creative direction: concept commercials, virtual creators, editorial images and product visuals."><section class="section creative-hero"><p class="eyebrow">AI Creative / Generative visuals</p><h1>IDEAS DON'T<br/> HAVE TO STAY<br/> IN YOUR HEAD.</h1><div class="creative-intro"><p>I use generative AI to turn concepts into commercials, campaign visuals, virtual creators, product photography and editorial imagery.</p><p class="evidence-note-text">A separate creative practice, grounded in visual storytelling. Brand concepts do not imply partnerships or commissions.</p></div><nav class="page-nav" aria-label="Creative categories"><a href="#commercials">01 / Commercials</a><a href="#creators">02 / Virtual creators</a><a href="#photoshoots">03 / Photoshoots</a><a href="#products">04 / Product visuals</a></nav></section>
<section id="commercials" class="section creative-section"><div class="section-heading"><div><p class="eyebrow">01 / AI commercials</p><h2>Make the idea move.</h2></div><p>Original films, paired with their supplied custom posters. Select a film to open the player.</p></div><div class="films">{films.map((film,i)=><article class:list={['film',{'film-wide':i<2}]}><VideoPreview file={film.file} poster={film.poster} title={`${film.brand}: ${film.title}`}/><p class="eyebrow">{film.label}</p><h3>{film.brand}<br/><em>{film.title}</em></h3><p>{film.description}</p></article>)}</div><p><a class="text-link" href="https://drive.google.com/drive/folders/1Sj88PciyCWuYka0i0DoDzrCk1h2sFKNN?usp=sharing" target="_blank" rel="noopener noreferrer">Explore more of my AI video work <span class="sr-only">(opens in a new tab)</span>↗</a></p></section>
<section id="creators" class="creative-soft"><div class="section creative-section"><div class="section-heading"><div><p class="eyebrow">02 / AI UGC &amp; virtual creators</p><h2>A character.<br/> A consistent presence.</h2></div><p>Character lookbooks and campaign variations explore persona consistency across styling, framing and setting. Concept imagery, not documented client commissions.</p></div><div class="persona-grid">{personas.map(([id,title,alt])=><article><EvidenceImage id={id} alt={alt}/><h3>{title}</h3></article>)}</div></div></section>
<section id="photoshoots" class="section creative-section"><div class="section-heading"><div><p class="eyebrow">03 / AI photoshoots</p><h2>Editorial instincts.<br/> New possibilities.</h2></div><p>Light, character, colour and composition. Original supplied images, shown without regenerating or altering faces.</p></div><div class="editorial-gallery">{photos.map(([id,title,alt])=><article><EvidenceImage id={id} alt={alt}/><p>{title}</p></article>)}</div></section>
<section id="products" class="product-band"><div class="section creative-section"><p class="eyebrow">04 / Product visuals</p><h2>Give the product<br/> a point of view.</h2><p>Independent campaign concepts. No brand partnership or commercial result is implied.</p><div class="product-editorial"><article class="perfume"><EvidenceImage id="perfume" alt="TAIYIBA perfume bottle in a dark burgundy and gold product composition"/><h3>TAIYIBA / Richness in restraint</h3></article><div class="sneaker-pair"><article><EvidenceImage id="floating-sneaker" alt="White sneaker floating against an orange background with particles"/><p>Suspended motion.</p></article><article><EvidenceImage id="low-sneaker" alt="Low-angle white sneaker campaign composition with an athlete against orange"/><p>A grounded perspective.</p></article></div></div></div></section>
<section class="section creative-cta"><p class="eyebrow">Have a concept in mind?</p><h2>Let's give it direction.</h2><a class="button solid" href={site.booking} target="_blank" rel="noopener noreferrer">Discuss a creative project <span class="sr-only">(opens in a new tab)</span>↗</a><a class="text-link" href="/#portfolio">Explore my operations &amp; systems work ↗</a></section></BaseLayout>
