---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import VideoPreview from '../components/VideoPreview.astro';
import {site} from '../data/site';
import {projects} from '../data/projects';
import assets from '../data/assets.json';
import {blueprints} from '../data/blueprints';
const capabilities=[
 ['Executive Assistance','I provide proactive executive support, managing complex schedules, communications, travel and competing priorities while anticipating needs, solving problems and keeping executives focused on what matters most.','View executive assistance work samples','/executive-operations/#scheduling'],
 ['Executive Operations','I coordinate projects, travel, documentation and follow-ups so people know what needs to happen, who owns it and what comes next.','Explore executive travel planning','/travel-command-center/'],
 ['AI-Powered Automation','I design and build AI-powered systems and automated workflows that connect tools, reduce repetitive work and make everyday business operations easier to manage.','Explore systems and workflows','/#portfolio']
];
const experience=[['Executive operations','Keeping the moving pieces from becoming problems.','Supported executive and founder workflows across scheduling, stakeholder communication, travel, meeting coordination, documentation and operational priorities.'],['Program operations','Turning ideas into programs people could actually attend.','At Be The Change Collective, supported coordination of virtual and in-person programs across schedules, speakers, communication, promotions and event logistics.'],['Process improvement','When the process is the problem, fix the process.','At SheVolution Global, helped improve administrative and scheduling workflows, creating clearer systems around classes, attendance and coordination.']];
---
<BaseLayout title={"HeyWunmi | Janet Oguns, Executive Assistance & Automation"} exactTitle description="Meet Janet Oguns, the professional behind HeyWunmi. Explore AI-powered executive assistance, business operations and workflow automation for founders and growing teams.">
 <section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">Hi, I'm Janet. <span class="small-rule"></span></p><h1 id="hero-title" aria-label="THE BOSS BEHIND THE BOSS."><span>THE BOSS</span><span>BEHIND</span><span>THE BOSS.</span></h1><p class="role">Executive Operations • AI Automation • Systems</p><p class="hero-intro">I'm Janet Oguns, the person behind HeyWunmi.</p><p class="hero-intro">I work with founders and executives to keep things running smoothly, from managing day-to-day priorities to building smarter systems that take repetitive work off their plates.</p><p class="hero-intro">My work brings together executive support, operations and AI-powered automation to help businesses run smarter, not harder.</p><div class="actions"><a class="button solid" href="#portfolio">Explore my work ↗</a><a class="text-link" href="#experience">Hiring credentials ↗</a></div></div><div class="hero-portrait"><img src="/images/hero-reference.png" width="1920" height="1008" alt="Janet wearing glasses and a black top against a dark studio background" fetchpriority="high"/><div class="portrait-caption"><span>OGUNS JANET OMOWUNMI</span><span>OPERATIONS. SYSTEMS. POSSIBILITIES.</span></div></div></section>
 <div class="discipline-strip"><span>EXECUTIVE OPERATIONS</span><span aria-hidden="true">✳</span><span>WORKFLOW AUTOMATION</span><span aria-hidden="true">✳</span><span>DIGITAL SYSTEMS</span><span aria-hidden="true">✳</span><span>AI CREATIVE DIRECTION</span></div>
 <ol class="methodology" aria-label="How I work">{['Understand the operation','Find the bottleneck','Design the solution','Build & automate'].map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol>
 <section id="portfolio" class="section"><div class="section-heading"><div><p class="eyebrow">01 / Featured systems &amp; builds</p><h2>Good systems.<br/> Real purpose.</h2></div><p>Operations thinking made tangible: practical solutions built around the work people need to do.</p></div>
  <div class="flagships">{projects.map((p,i)=><article class:list={['flagship',{'flagship-lead':i===0}]}><a class="project-image" href={`/${p.slug}/`} aria-label={`View ${p.title} case study`}><img src={`/images/${p.image}.webp`} alt={`${p.title}: original project interface`} width={assets.find(a=>a.id===p.image)?.width} height={assets.find(a=>a.id===p.image)?.height} loading="lazy"/></a><div class="flagship-copy"><p class="eyebrow">0{i+1} / {p.category}</p><h3><a href={`/${p.slug}/`}>{p.title}</a></h3><p>{p.intro}</p><ul class="tool-list" aria-label={`${p.title} tools`}>{p.tools.map(tool=><li>{tool}</li>)}</ul><a class="text-link" href={`/${p.slug}/`}>View case study ↗</a></div></article>)}</div>
 </section>
 <section id="work" class="blueprints-band"><div class="section"><div class="section-heading"><div><p class="eyebrow">02 / Automation blueprints</p><h2>The logic behind<br/> less busywork.</h2></div><p>Practical workflows and demonstrations of process understanding, tool integration and business logic.</p></div>{blueprints.map((b,i)=><details class="workflow"><summary><span class="workflow-index">0{i+1}</span><span><strong>{b.title}</strong><span class="workflow-tools">{b.tools}</span></span><span class="expand" aria-hidden="true">+</span></summary><div class="workflow-content"><p>{b.description}</p><ol class="mini-flow">{b.steps.map(step=><li>{step}</li>)}</ol>{b.image ? <div class:list={['blueprint-evidence',{'narrow-evidence':b.image==='zapier-airtable'}]}><EvidenceImage id={b.image} alt={`${b.title}: original automation steps`}/></div> : <p class="pending-evidence">Separate workflow evidence awaiting confirmation.</p>}<p class="evidence-note-text">{b.note}</p></div></details>)}</div></section>
 <section id="operations" class="section operations"><div><p class="eyebrow">03 / How I support your business</p><h2>Executive assistance.<br/> Executive operations.<br/> AI-powered automation.</h2><p>I bring together hands-on support, operational coordination and practical automation: supporting the person, organizing the work and improving the systems behind it.</p><a class="text-link" href="/executive-operations/">Explore assistance and operations work samples ↗</a></div><div class="operations-list">{capabilities.map(([title,text,label,href],i)=><article><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p><a class="text-link" href={href}>{label} ↗</a></div></article>)}</div></section>
 <section id="experience" class="experience-band"><div class="section experience-section"><p class="eyebrow">Professional experience / The foundation</p><h2>Operations first.<br/> Systems thinking always.</h2><div class="experience-stories">{experience.map(([label,title,text],i)=><article><p class="eyebrow">0{i+1} / {label}</p><h3>{title}</h3><p>{text}</p></article>)}</div><div class="credentials"><a href="/executive-operations/">View work samples ↗</a><a href={site.linkedin}>LinkedIn ↗</a><a class="button light" href={site.cv} download>Download CV (PDF) ↓</a></div></div></section>
 <section id="testimonials" class="section testimonials"><p class="eyebrow">04 / In their words</p><h2>Trusted with the work.<br/> Remembered for the approach.</h2><div class="testimonial-layout"><figure class="quote-featured"><blockquote>She saw a gap, filled it, and now leads it. That is not the behavior of someone waiting to be told what to do. That is a leader in action.</blockquote><figcaption><strong>Kat Da Silva</strong><span>Executive Director · Be The Change Collective, USA</span></figcaption></figure><div class="supporting-quotes"><figure><blockquote>Working with Janet was a delight. She is detailed, focused, and brings both creativity and calm to her role. Her consistency and sense of responsibility stood out, and she often took the lead on key tasks without being prompted. She is the kind of team member every leader wants.</blockquote><figcaption><strong>Victoria V.</strong><span>Founder · SheVolution Global, Nigeria</span></figcaption></figure><figure><blockquote>Her ability to craft compelling job descriptions that attract the right candidates is remarkable. She not only nailed the technical aspects of the role but also kept things running smoothly with her attention to detail and efficiency, ensuring no task was overlooked. What truly sets Janet apart is her collaborative spirit and positive attitude.</blockquote><figcaption><strong>Faustina Chimonge Nwokolo</strong><span>Technical Support Engineer, CRM &amp; Automation, Cloud DevOps</span></figcaption></figure></div></div></section>
 <section id="about" class="section about"><div class="about-portrait"><img src="/images/wunmi-about.webp" width="640" height="853" loading="lazy" alt="Janet wearing a black pinstripe blazer against a neutral studio background"/></div><div><p class="eyebrow">05 / About Janet</p><h2>An operations mind.<br/> A creative approach<br/> to technology.</h2><p>My work started with supporting people and keeping things organized. Over time, I became just as interested in the systems behind the work: what's slowing people down, what can be simplified and what shouldn't need to be done manually in the first place.</p><p>That background taught me to spot the gaps between tasks, tools and people. Today, I use automation, AI and digital systems to solve those same operational problems from the systems side.</p><p>I also work with generative AI for creative direction and commercial visual storytelling.</p><a class="text-link" href="/ai-creative/">Explore AI Creative ↗</a></div><div class="about-introduction"><div><p class="eyebrow">Meet Janet</p><h3>A little about me.</h3><p>A little about me, how I think and what drives my work.</p></div><VideoPreview file="meet-wunmi" poster="meet-wunmi" title="Meet Janet: personal introduction" playLabel="Watch introduction" note="A personal introduction to the person behind the work."/></div></section>
 <section id="contact" class="contact-band"><div class="section"><p class="eyebrow">06 / Work with me</p><h2>Let's make your<br/> next move easier.</h2><div class="contact-paths"><div><h3>Hiring for a role?</h3><p>Explore my experience and work samples for executive assistance, operations and AI automation roles.</p><a class="button light" href="#experience">View experience ↗</a><a class="text-link" href={site.cv} download>Download CV (PDF) ↓</a></div><div><h3>Looking for direct support?</h3><p>Let's discuss executive assistance, operational coordination or an automation project.</p><a class="button light" href={site.booking} target="_blank" rel="noopener noreferrer">Book a discovery call <span class="sr-only">(opens in a new tab)</span>↗</a></div></div><a class="contact-email" href={`mailto:${site.email}`}>{site.email} ↗</a></div></section>
</BaseLayout>
